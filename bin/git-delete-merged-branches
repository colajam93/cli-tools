#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 && ( $1 == -h || $1 == --help ) ]]; then
    printf 'Usage: git delete-merged-branches\nDelete local branches merged into HEAD, except branches checked out in any worktree.\n'
    exit 0
fi
if [[ $# -ne 0 ]]; then
    printf 'Usage: git delete-merged-branches\n' >&2
    exit 1
fi

branches=$(git branch --no-color --no-column --merged=HEAD)
status=0
while read -r branch; do
    case $branch in
        ''|'* '*|'+ '*) continue ;;
    esac
    git branch -d -- "$branch" || status=1
done <<< "$branches"
exit "$status"
